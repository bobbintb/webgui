#!/bin/bash
#
# script: emhttp
#
# Start emhttpd. The nginx components are started during emhttpd initialization.
#
# Usage:
#   emhttp [OPER]
#
# OPER is start or stop.  Default is start.
#
# LimeTech - modified for Unraid OS
# Bergware - modified for Unraid OS, October 2023

# Run & log functions
[[ -f /etc/rc.d/rc.runlog ]] && . /etc/rc.d/rc.runlog

# Compatibility handling for deprecated options
while getopts ":p:r" OPT; do
  case $OPT in
    p|r) ;; # Ignored
    *) echo "Unknown option: $OPT"
       exit 1
  esac
done
shift $((OPTIND-1))

OPER="${1:-start}"

/**
 * Start emhttpd and related services.
 */
start_services() {
  log "Starting emhttpd..."

  # Verify emhttpd not already started
  if pgrep --ns $$ emhttpd >/dev/null; then
    log "emhttpd already started."
    exit 1
  fi

  # Start emhttpd daemon
  if [[ -x /usr/libexec/unraid/emhttpd ]]; then
    /usr/libexec/unraid/emhttpd
  else
    log "Error: /usr/libexec/unraid/emhttpd not found."
    exit 1
  fi
}

/**
 * Stop emhttpd and related services.
 */
stop_services() {
  log "Stopping web services..."

  # Kill nchan monitor
  if [[ -x /usr/local/sbin/monitor_nchan ]]; then
    /usr/local/sbin/monitor_nchan kill
  fi

  # Stop Nginx and PHP-FPM
  [[ -x /etc/rc.d/rc.nginx ]] && /etc/rc.d/rc.nginx stop
  [[ -x /etc/rc.d/rc.php-fpm ]] && /etc/rc.d/rc.php-fpm stop

  log "Stopping emhttpd..."
  pkill --ns $$ emhttpd

  # Clean up module
  if lsmod | grep -q "^md_mod "; then
    rmmod md-mod 2>/dev/null
  fi

  log "All services... Stopped."
}

case "$OPER" in
  'start')
    start_services
    ;;
  'stop')
    stop_services
    ;;
  *)
    echo "Unknown operation: $OPER"
    exit 1
    ;;
esac

exit 0
