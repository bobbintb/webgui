#!/bin/bash
#Copyright 2005-2025, Lime Technology, Inc.
#License: GPLv2 only

# This is the 'mover' script used for moving files between pools and/or the main unRAID array.
# It is typically invoked via cron.

# Constants
PIDFILE="/var/run/mover.pid"
CFGPATH="/boot/config/shares"
MOVE_CMD="/usr/libexec/unraid/move"
DEBUGGING=""

# Functions

/**
 * Move files from source path.
 * Performs two passes: one for all entries, and a second to clean up empty directories.
 */
move() {
  local src="$1"
  if [[ -d "$src" ]]; then
    find "$src" -depth 2>/dev/null | "$MOVE_CMD" $DEBUGGING
    # Second pass for empty directories
    find "$src" -depth -type d -empty 2>/dev/null | "$MOVE_CMD" $DEBUGGING
  fi
}

/**
 * Recursively kill a process tree.
 */
killtree() {
  local pid=$1 child
  for child in $(pgrep --ns $$ -P "$pid"); do
    killtree "$child"
  done
  if [[ $pid -ne $$ ]]; then
    kill -TERM "$pid" 2>/dev/null
  fi
}

/**
 * Start the mover process.
 */
start() {
  # Check if already running
  if [[ -f $PIDFILE ]]; then
    local old_pid=$(cat "$PIDFILE")
    if ps -p "$old_pid" -o comm= | grep -q "mover"; then
      echo "mover: already running (PID $old_pid)" >&2
      exit 1
    fi
  fi

  echo $$ > "$PIDFILE"
  echo "mover: started" >&2

  shopt -s nullglob

  # Iterate through share configurations
  for SHARECFG in "$CFGPATH"/*.cfg; do
    local SHARE=$(basename "$SHARECFG" .cfg)

    # Safely load configuration
    # Note: Using fromdos to handle potential DOS line endings in config files
    if [[ -f "$SHARECFG" ]]; then
      # Reset variables before sourcing
      local shareUseCache="" shareCachePool="" shareCachePool2=""
      eval "$(fromdos < "$SHARECFG" | grep -E '^(shareUseCache|shareCachePool|shareCachePool2)=')"
    fi

    # Case 1: Move from Primary to Secondary (Yes)
    if [[ $shareUseCache == "yes" && -n $shareCachePool ]]; then
      local src="/mnt/$shareCachePool/$SHARE"
      if [[ -d "$src" ]]; then
        if [[ -n $shareCachePool2 ]]; then
          # Secondary is another pool
          [[ -d "/mnt/$shareCachePool2" ]] && move "$src"
        else
          # Secondary is the array; ensure array has data disks
          local disks=(/mnt/disk[1-9]/ /mnt/disk[1-9][0-9]/)
          [[ ${#disks[@]} -gt 0 ]] && move "$src"
        fi
      fi
    fi

    # Case 2: Move from Secondary to Primary (Prefer)
    if [[ $shareUseCache == "prefer" ]]; then
      if [[ -n $shareCachePool2 ]]; then
        # Secondary is a pool
        local src="/mnt/$shareCachePool2/$SHARE"
        [[ -d "$src" && -n $shareCachePool && -d "/mnt/$shareCachePool" ]] && move "$src"
      else
        # Secondary is the array
        if [[ -n $shareCachePool && -d "/mnt/$shareCachePool" ]]; then
          for src in /mnt/disk[1-9]/"$SHARE"/ /mnt/disk[1-9][0-9]/"$SHARE"/; do
            [[ -d "$src" ]] && move "$src"
          done
        fi
      fi
    fi
  done

  # Process disks being emptied
  local share_cfg="/boot/config/share.cfg"
  if [[ -f "$share_cfg" ]]; then
    local emptying=$(grep '^shareUserEmptying=' "$share_cfg" | cut -d'"' -f2)
    IFS=',' read -ra disk_arr <<< "$emptying"
    for disk in "${disk_arr[@]}"; do
      [[ -z $disk ]] && continue

      # Move files from share directories on this disk
      for share_path in /mnt/"$disk"/*; do
        local share_name=$(basename "$share_path")
        if [[ -d "$share_path" && -f "$CFGPATH/$share_name.cfg" ]]; then
          move "$share_path"
        fi
      done

      # Report files that could not be moved
      local count=$(find /mnt/"$disk" -mindepth 1 2>/dev/null | wc -l)
      if [[ "$count" -gt 0 ]]; then
        find /mnt/"$disk" -mindepth 1 -depth -printf 'move: %p Not moved\n' 2>/dev/null | head -n 100
        [[ "$count" -gt 100 ]] && echo "[output truncated to first 100 entries]"
      fi
    done
  fi

  rm -f "$PIDFILE"
  echo "mover: finished" >&2
}

/**
 * Stop the mover process.
 */
stop() {
  if [[ ! -f $PIDFILE ]]; then
    echo "mover: not running"
    exit 0
  fi
  local pid=$(cat "$PIDFILE")
  killtree "$pid"
  sleep 2
  rm -f "$PIDFILE"
  echo "mover: stopped"
}

/**
 * Show script usage.
 */
usage() {
  echo "Usage: $0 {start|stop|status}"
  exit 1
}

# Main execution

if [[ $# -ne 1 ]]; then
  usage
fi

case "$1" in
  start)
    start
    ;;
  stop)
    stop
    ;;
  status)
    if [[ -f $PIDFILE ]] && ps -p "$(cat "$PIDFILE")" -o comm= | grep -q "mover"; then
      echo "mover: running"
      exit 0
    else
      echo "mover: not running"
      exit 1
    fi
    ;;
  *)
    usage
    ;;
esac
